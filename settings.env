# Español Trainer settings. Open this file in Notepad, edit, save, then restart the app.
# Lines starting with # are comments.
#
# The app works fully WITHOUT any key: chapters, quizzes, review and word of the day.
# A key only switches on the "check my sentence" and "chat with Lucía" features.

# Which AI to use: gemini or deepseek
PROVIDER=gemini

# ---- Gemini (Google). Has a free tier with daily limits. Get a key at aistudio.google.com ----
GEMINI_API_KEY=
# Model name: copy the exact name of a Flash-Lite model from Google AI Studio if this one errors.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- DeepSeek. Small free credit on signup, then pay-as-you-go. Key at platform.deepseek.com ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Port the app runs on, if 3000 is already used by something else.
PORT=3000
