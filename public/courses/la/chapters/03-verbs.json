  "write": {
    "title": "Write it in Latin",
    "task": "Introduce yourself in Latin: say who you are, two things you love or see, and one thing you don't fear.",
    "starter": "Ego sum…  Rōmam amō…  Nōn timeō…",
    "model": "Ego sum {name}. Rōmam amō et templa antīqua videō. Equōs nōn timeō.",
    "checklist": [
      "Verb endings: -ō for I, -s for you, -mus for we",
      "Things you love or see take the receiver ending: -am, -um, -ās, -ōs, or -a for neuter plurals",
      "Nōn goes just before the verb"
    ]
  },
