            "él / ella / usted",
            "habla",
            "he / she speaks"
          ],
          [
            "-amos",
            "nosotros",
            "hablamos",
            "we speak"
          ],
          [
            "-áis",
            "vosotros",
            "habláis",
            "you all speak"
          ],
          [
            "-an",
            "ellos / ellas",
            "hablan",
            "they speak"
          ]
        ]
      },
      {
        "title": "-ER and -IR verbs: comer, vivir",
        "tone": "orange",
        "rows": [
          [
            "-o",
            "yo",
            "como · vivo",
            "I eat · I live"
          ],
          [
            "-es",
            "tú",
            "comes · vives",
            "you eat · you live"
          ],
          [
            "-e",
            "él / ella / usted",
            "come · vive",
            "he / she eats · lives"
          ],
          [
            "-emos / -imos",
            "nosotros",
            "comemos · vivimos",
            "we eat · we live"
          ],
          [
            "-éis / -ís",
            "vosotros",
            "coméis · vivís",
            "you all eat · live"
          ],
          [
            "-en",
            "ellos / ellas",
            "comen · viven",
            "they eat · they live"
          ]
        ]
      }
    ]
  },
