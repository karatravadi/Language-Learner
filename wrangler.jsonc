// Hosted Stilus: one Worker serves public/ as static files and answers /api/*.
// Deploy: npx wrangler deploy. Local: npm run dev:hosted (uses a local database and .dev.vars).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The name is the address: stilus.karatravadi.workers.dev (was espanol-trainer until Nov 2026).
  "name": "stilus",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Cloudflare Access (All traffic) protects the Worker on every address, so workers.dev is safe to switch on.
  "workers_dev": true,
  "preview_urls": false,
  // Run the Worker code (only /api/*) near a US Google Cloud region. Gemini refuses some locations
  // ("User location is not supported", a 400) depending on which data centre a request lands in.
  // Static files are still served from the nearest data centre.
  "placement": { "region": "gcp:us-east4" },
  // Workers Logs (free plan): keeps errors such as the AI provider's reason for a few days, in the dashboard.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "espanol-trainer",
      "database_id": "62c8a4cb-706e-4c3f-b86d-67ccb08cba06",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PROVIDER": "gemini",
    // Gemini 3.5 Flash-Lite, chosen 2 Nov 2026. Free tier: 15 requests a minute and 500 a day, for the whole project.
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // AI calls per person per day, and for everyone together (keep this under the provider's free daily quota).
    "AI_DAILY_PER_USER": "60",
    "AI_DAILY_GLOBAL": "450"
  }
  // Secrets, set with `npx wrangler secret put NAME`, never in this file:
  //   GEMINI_API_KEY (or DEEPSEEK_API_KEY)
  //   ACCESS_TEAM  your Zero Trust team name (the part before .cloudflareaccess.com; the full address also works)
  //   ACCESS_AUD   the Application Audience (AUD) tag of the Worker's Access application
  // Until both ACCESS_ values are set, the API refuses every request (the Worker fails closed).
}
